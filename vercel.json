{
  "redirects": [
    {
      "source": "/history/",
      "destination": "/history",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/site/index.html"
    },
    {
      "source": "/history",
      "destination": "/site/index.html"
    },
    {
      "source": "/sw.js",
      "destination": "/site/sw.js"
    },
    {
      "source": "/img/:path*",
      "destination": "/site/img/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}